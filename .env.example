# Ejemplo de configuración. Copiar a ".env" y completar (".env" NO se sube a git).
# Ninguna variable es obligatoria: si no existe .env, el proyecto usa los valores por defecto.

# Clave de Django para firmar las cookies de sesión.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Si se deja vacía, se genera una aleatoria en cada arranque.
DJANGO_SECRET_KEY=

# 1 = modo desarrollo (muestra errores detallados), 0 = desactivado
DJANGO_DEBUG=1

# Dirección del servidor Ollama. Con docker compose se usa el contenedor "ollama".
# Sin Docker, con Ollama instalado localmente: http://localhost:11434
OLLAMA_HOST=http://ollama:11434
